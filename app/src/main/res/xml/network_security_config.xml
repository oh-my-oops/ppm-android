<?xml version="1.0" encoding="utf-8"?>
<!-- PPM is a server on the user's own machine, routinely reached over plain HTTP on a LAN or
     Tailscale, and sometimes over HTTPS with a certificate from the user's own CA. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
