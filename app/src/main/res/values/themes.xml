<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window: everything inside is drawn by Compose. The background is Aurora
         Dark's, so that the first frame is not a white flash. -->
    <style name="Theme.Ppm" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ppm_launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <color name="ppm_launch_background">#0A0E17</color>
    <color name="ppm_icon_background">#1A1F2E</color>
</resources>
