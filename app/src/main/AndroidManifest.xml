<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The chat mic: asked for the first time it is pressed. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Handing Android's installer an update downloaded from GitHub Releases. Android still
         asks the user to let PPM install apps ("Install unknown apps") before the first one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Push notifications: requested only when the user turns on the "This device" switch
         in Settings -> Notifications, never on first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The chat's "Add to chat" chip for a photo or screenshot just taken: asked for only when
         the user taps a chip offering one the app cannot read yet, never on launch. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 14+ tells the app a screenshot of it was taken, with no photo access: a normal
         permission, granted at install. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <!-- The camera and camcorder the paperclip's chooser offers beside Files, as Chrome's does.
         Neither needs the CAMERA permission: the app never declares it, so the camera app asks. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <!-- The speech recognisers the mic can use, Google's first as Chrome picks it. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- UnifiedPush distributors (ntfy, NextPush, etc.) discovered on Android 11+. -->
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="unifiedpush" android:host="link" />
        </intent>
    </queries>

    <application
        android:name=".PpmApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PPM"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ppm">
        <!-- Compose redraws for a new size or orientation itself: recreating the activity
             would only lose scroll positions and open sheets. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ppm://<server>/project/{name}/{type}/{id}: the web's address on a saved server.
                 A self-hosted server's own https links cannot be verified as App Links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ppm" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ProjectWindowActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:documentLaunchMode="always"
            android:windowSoftInputMode="adjustResize" />
        <!-- Hands a picture copied in the lightbox to the app it is pasted into, and the camera the
             file to write a photo for the message box into. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.images"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/image_paths" />
        </provider>
        <receiver
            android:name=".push.UnifiedPushReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
