<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The chat mic: asked for the first time it is pressed. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Opening Android's installer on an update downloaded from GitHub Releases. Android still
         asks the user to let PPM install apps ("Install unknown apps") before the first one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The camera and camcorder the paperclip's chooser offers beside Files, as Chrome's does.
         Neither needs the CAMERA permission: the app never declares it, so the camera app asks. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <!-- The speech recognisers the mic can use, Google's first as Chrome picks it. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".PpmApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PPM"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ppm">
        <!-- Compose redraws for a new size or orientation itself: recreating the activity
             would only lose scroll positions and open sheets. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ppm://<server>/project/{name}/{type}/{id}: the web's address on a saved server.
                 A self-hosted server's own https links cannot be verified as App Links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ppm" />
            </intent-filter>
        </activity>
        <!-- Hands a picture copied in the lightbox to the app it is pasted into, the camera the
             file to write a photo for the message box into, and the installer an update. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.images"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/image_paths" />
        </provider>
    </application>
</manifest>
