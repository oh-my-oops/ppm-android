+// Only trim the artificial context boundary, never the actual selection/caret boundary.
+private fun contextStart(text: CharSequence, end: Int): Int {
+    val start = max(0, end - SURROUNDING_CHARS)
+    return if (start > 0 && start < end && text[start].isLowSurrogate() && text[start - 1].isHighSurrogate()) start + 1 else start
+}
+
+private fun contextEnd(text: CharSequence, start: Int): Int {
+    val end = start + min(SURROUNDING_CHARS, text.length - start)
+    return if (end < text.length && end > start && text[end - 1].isHighSurrogate() && text[end].isLowSurrogate()) end - 1 else end
+}
+
 /** Characters on each side of the selection handed to the input method in one read. */
 private const val SURROUNDING_CHARS = 2048
 
